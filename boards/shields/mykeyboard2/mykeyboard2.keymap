#define ZMK_POINTING_DEFAULT_SCRL_VAL 150
#include <dt-bindings/zmk/outputs.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/mouse.h>

// Layer Numbering

#define DEFAULT 0
#define NUM     1
#define CTRL    2

/ {
    behaviors {
        sensor_rotate_kp: sensor_rotate_kp {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&kp>, <&kp>;
        };

        mouse_wheel_scroll: mouse_wheel_scroll {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;

            tap-ms = <20>;
        };
    };

    macros {
        mclk_hold_tap: mclk_hold_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&mkp>, <&mkp>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
        };

        shift_left: shift_left {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(LEFT)>;
        };
    
        shift_right: shift_right {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(RIGHT)>;
        };
        mouse_copy: mouse_copy {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;

            bindings =
                <&mkp RCLK>
                , <&macro_wait_time 100>
                , <&kp C>
                ;
        };

        mouse_paste: mouse_paste {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;

            bindings =
                <&mkp RCLK>
                , <&macro_wait_time 100>
                , <&kp LC(V)>
                ;
        };
    };


    keymap {
        compatible = "zmk,keymap";

        default_layer {
            label = "DEFAULT";
            bindings = <
                &tog 1     &kp LS(N9)      &kp LS(N0)  &kp EQUAL   &kp LS(TAB)      &kp LC(C)
                &kp F2    &kp LS(N5)     &kp KP_MULTIPLY    &kp KP_MINUS    &kp LC(A)    &kp LC(P)
                &kp N7     &kp N8    &kp N9    &kp KP_PLUS   &none    &kp LC(Z)
                &kp N4     &kp N5    &kp N6    &kp PRCNT    &kp TAB   &mo 2
                &tog 1    &kp N1     &kp N2    &kp N3    &kp ENTER    &kp DOT
                &kp LEFT     &kp UP    &kp DOWN    &kp RIGHT    &kp N0     &kp LC(Y)
                &kp LCTRL     &kp LALT    &mkp MCLK    &none        &none    &none
            >;
            sensor-bindings = 
                <&sensor_rotate_kp LS(RIGHT) LS(LEFT)>,
                <&mouse_wheel_scroll SCRL_UP SCRL_DOWN>;
        };

        num_layer {
            label = "NUM";
            bindings = <
                &tog 1    &trans    &trans    &trans    &trans    &trans
                &trans    &trans    &trans    &trans    &trans    &trans
                &trans    &trans    &trans    &trans    &trans    &trans
                &trans    &trans    &trans    &trans    &trans    &trans
                &trans    &trans    &trans    &trans    &trans    &trans
                &trans    &trans    &trans    &trans    &trans    &trans
                &trans    &trans    &trans    &trans    &trans    &trans
            >;

            sensor-bindings = 
                <&sensor_rotate_kp LS(LEFT) LS(RIGHT)>,
                <&mouse_wheel_scroll SCRL_DOWN SCRL_UP>;
        };
        layer_2 {
            label = "CTRL";
            bindings = <
                &trans    &trans    &trans    &trans    &trans    &trans
                &trans    &trans    &trans    &trans    &trans    &trans
                &trans    &trans    &trans    &trans    &trans    &trans
                &trans    &trans    &trans    &trans    &trans    &trans
                &trans    &trans    &trans    &trans    &trans    &trans
                &trans    &trans    &trans    &trans    &trans    &trans
                &trans    &trans    &trans    &trans    &trans    &trans
            >;
            sensor-bindings = 
                <&sensor_rotate_kp LS(LEFT) LS(RIGHT)>,
                <&mouse_wheel_scroll SCRL_DOWN SCRL_UP>;
            
            
        };
    };
};
