#define ZMK_POINTING_DEFAULT_SCRL_VAL 150

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/mouse.h>

// Layer Numbering

#define DEFAULT 0
#define NUM     1

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            label = "DEFAULT";
            bindings = <
                &kp BSPC   &kp SLASH        &kp ASTERISK  &kp MINUS   &kp RET     &kp BSPC
                &kp N7     &kp N8           &kp N9        &kp PLUS    &kp UP      &kp BSPC
                &kp N4     &kp N5           &kp N6        &kp LC(C)   &kp LEFT    &kp BSPC
                &kp N1     &kp N2           &kp N3        &kp LC(V)   &kp RIGHT   &kp BSPC
                &kp N0     &kp DOT          &mkp MCLK     &kp LALT    &kp DOWN    &kp BSPC
                &kp N0     &kp DOT          &mkp MCLK     &kp LALT    &kp DOWN    &kp BSPC
            >;

            sensor-bindings = <&mouse_wheel_scroll SCRL_UP SCRL_DOWN>;
        };
    };
};
